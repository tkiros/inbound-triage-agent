# Copy to .env (make does this for you). Never commit .env.

# Uncomment and set, OR run `ant auth login` and leave this commented out
# (a set-but-empty key can shadow the login profile). A key exported in your shell wins.
# ANTHROPIC_API_KEY=

# 1 = offline mode (keyword classifier + template drafts, no model calls); 0 = use the model.
# Unset: offline when ANTHROPIC_API_KEY is unset. Using `ant auth login`? Set it to 0.
# TRIAGE_OFFLINE=

# Host-side runs (make test / make eval). The app container overrides this with the service name.
DATABASE_URL=postgresql://app:app@localhost:5436/app

# Tags every llm_calls row so several projects can share one database.
PROJECT_NAME=inbound-triage

# Optional model overrides (defaults live in common/llm.py).
# LLM_MODEL_SMALL=claude-haiku-5-5
# LLM_MODEL_LARGE=claude-opus-5-5

# Optional shared secret: when set, POST /inbound requires the header X-Inbound-Token.
# INBOUND_TOKEN=

# Slack approver (optional; without these, use `make pending` and `make approve`).
# Bot User OAuth Token from "Install App" (xoxb-...): posts and updates approval messages.
# SLACK_BOT_TOKEN=
# App-level token with scope connections:write (xapp-...): the Socket Mode connection.
# SLACK_APP_TOKEN=
# ID of the channel held emails are posted to (the bot must be invited), e.g. C0123456789.
# SLACK_APPROVAL_CHANNEL=
# Comma-separated Slack user IDs allowed to approve; empty = anyone in the channel.
# SLACK_APPROVERS=
